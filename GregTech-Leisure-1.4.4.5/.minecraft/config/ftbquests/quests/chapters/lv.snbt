	quests: [
		{
			dependencies: ["51B9A72C19F84F0E"]
			description: ["Electric motors are a device for converting electrical energy into mechanical energy. Its working method is based on electromagnetic sensors, which generate power in the magnetic field when the current passes through an electric-motive wire, a force that rotates the electric-motive rotor and drives the load. Electric motors are widely used in various industrial, commercial and household appliances."]
			id: "0223A643A5066452"
			rewards: [{
				id: "370F298DE7E8BDFA"
